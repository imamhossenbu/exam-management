# Copy this file to .env.local and fill in values from the Supabase Dashboard.
# Never commit .env.local. Never prefix secrets with NEXT_PUBLIC_.

# Supabase project (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://cazeweyqwlcmqyuwsrhq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=PASTE_FULL_PUBLISHABLE_KEY_HERE

# Public URL of this app, used for auth email redirects (no trailing slash).
NEXT_SITE_URL=http://localhost:3000

# Required for custom Nodemailer OTP & password reset links (Dashboard → Project Settings → API Keys → service_role secret).
SUPABASE_SECRET_KEY=PASTE_SERVICE_ROLE_SECRET_KEY_HERE

# Gmail / SMTP Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="ExamDesk <your_email@gmail.com>"

# Optional: direct PostgreSQL access for migrations (Dashboard → Connect).
DATABASE_URL=PASTE_NEW_DATABASE_CONNECTION_STRING_HERE

# Optional: only for custom JWT verification. Not required — supabase.auth.getClaims()
# already verifies tokens against the project's JWKS.
SUPABASE_JWKS_URL=https://cazeweyqwlcmqyuwsrhq.supabase.co/auth/v1/.well-known/jwks.json

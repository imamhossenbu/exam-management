# Copy to .env.e2e.local (git-ignored) to run `npm run test:e2e` against your Supabase project.
# The suite signs in as the teacher, creates "E2E …" test data and temporary students, then deletes it all.
E2E_TEACHER_EMAIL=teacher@example.com
E2E_TEACHER_PASSWORD=PASTE_TEACHER_PASSWORD_HERE
# Optional: app URL (defaults to http://localhost:3000; start `npm run dev` first).
# E2E_BASE_URL=http://localhost:3000
